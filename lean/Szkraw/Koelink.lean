import Szkraw.ComboCounterexamples
import Szkraw.TowerCharacter

/-!
# P3, Proposition 6.3: agreement with formulas transcribed from Koelink (2000)

Koelink, *q-Krawtchouk polynomials as spherical functions on the Hecke algebra of type B*, Trans. AMS 352 (2000).
The formulas below are **transcribed by hand** from that paper; Lean checks that they agree with the constructions
of P3, not that the transcription is faithful.

* Theorem 3.1(ii), relation (3.2): `u(x_j)² = (q-1) u(x_j) (u(x_{j+1}) + ⋯ + u(x_n)) + (p-1) u(x_j) + p q^(n-j)`,
  `1 ≤ j ≤ n`, in a commutative algebra generated by the `u(x_j)` (`koelink_relation_32`, with `u(x_{i+1})` the
  generator `towerGenerator p q N i`).
* Theorem 7.1: `(p(1-q^(n-f)) - (1-q^f)) φ(d) = p q^d (1-q^(n-d)) φ(d+1) + (1-q^d)(p-1) φ(d) + (1-q^d) φ(d-1)` with
  `φ(0) = 1`. Its coefficients divided by `p(1-q^n)` are those of the array (eq:parameters) with `r = 1/p`, and every
  solution is `φ(d) = R_d(x_f)` with `x_f = (p(1-q^(N-f)) - (1-q^f))/(p(1-q^N))` (`koelink_recurrence_71`).
-/

namespace Szkraw

open Finset

theorem qa_sum_mk {R : Type*} [CommRing R] {a b : R} {ι : Type*} (t : Finset ι) (f : ι → R) :
    ∑ i ∈ t, (⟨f i, 0⟩ : QuadraticAlgebra R a b) = ⟨∑ i ∈ t, f i, 0⟩ := by
  classical
  induction t using Finset.induction_on with
  | empty => rfl
  | insert x t hx ih => rw [Finset.sum_insert hx, Finset.sum_insert hx, ih]; ext <;> simp

/-- The `sum` field of the tower is the sum of its generators. -/
theorem tower_sum_eq (p q : ℝ) : ∀ N, (tower p q N).sum = ∑ i : Fin N, towerGenerator p q N i
  | 0 => by simp [tower]
  | N + 1 => by
    rw [Fin.sum_univ_succ]
    have hs : ∑ j : Fin N, towerGenerator p q (N + 1) j.succ = ⟨∑ j : Fin N, towerGenerator p q N j, 0⟩ := by
      simp only [towerGenerator, Fin.cases_succ]
      exact qa_sum_mk _ _
    rw [hs, ← tower_sum_eq p q N]
    simp only [towerGenerator, Fin.cases_zero]
    ext <;> simp [tower]

theorem sum_filter_succ_lt {M : Type*} [AddCommMonoid M] {N : ℕ} (f : Fin (N + 1) → M) (j : Fin N) :
    ∑ l ∈ univ.filter (fun l => j.succ < l), f l = ∑ l ∈ univ.filter (fun l => j < l), f l.succ := by
  rw [Finset.sum_filter, Finset.sum_filter, Fin.sum_univ_succ]
  simp [Fin.succ_lt_succ_iff, not_lt.2 (Fin.zero_le _)]

theorem sum_filter_zero_lt {M : Type*} [AddCommMonoid M] {N : ℕ} (f : Fin (N + 1) → M) :
    ∑ l ∈ univ.filter (fun l => (0 : Fin (N + 1)) < l), f l = ∑ l : Fin N, f l.succ := by
  rw [Finset.sum_filter, Fin.sum_univ_succ]
  simp [Fin.succ_pos]

/-- **Koelink, Theorem 3.1(ii), relation (3.2)**, transcribed: the generator `z_i = u(x_{i+1})` satisfies
`z_i² = ((q-1) Σ_{l>i} z_l + (p-1)) z_i + p q^(N-1-i)`. -/
theorem koelink_relation_32 (p q : ℝ) : ∀ (N : ℕ) (i : Fin N),
    towerGenerator p q N i * towerGenerator p q N i =
      ((q - 1) • ∑ l ∈ univ.filter (fun l => i < l), towerGenerator p q N l +
        algebraMap ℝ (tower p q N).Carrier (p - 1)) * towerGenerator p q N i +
      algebraMap ℝ (tower p q N).Carrier (p * q ^ (N - 1 - i.val))
  | 0, i => Fin.elim0 i
  | N + 1, i => by
    have halg : ∀ r : ℝ, algebraMap ℝ (tower p q (N + 1)).Carrier r =
        ⟨algebraMap ℝ (tower p q N).Carrier r, 0⟩ := fun r => rfl
    refine Fin.cases ?_ (fun j => ?_) i
    · rw [sum_filter_zero_lt]
      have hs : ∑ l : Fin N, towerGenerator p q (N + 1) l.succ = ⟨(tower p q N).sum, 0⟩ := by
        simp only [towerGenerator, Fin.cases_succ]
        rw [qa_sum_mk, tower_sum_eq]
      rw [hs, halg, halg]
      simp only [towerGenerator, Fin.cases_zero, Fin.val_zero, Nat.add_sub_cancel, Nat.sub_zero]
      ext
      · simp only [QuadraticAlgebra.re_mul, QuadraticAlgebra.re_add, QuadraticAlgebra.re_smul,
          QuadraticAlgebra.im_smul, QuadraticAlgebra.im_add, QuadraticAlgebra.im_mul]
        simp
      · simp only [QuadraticAlgebra.im_mul, QuadraticAlgebra.re_add, QuadraticAlgebra.re_smul,
          QuadraticAlgebra.im_smul, QuadraticAlgebra.im_add, QuadraticAlgebra.re_mul]
        simp
    · rw [sum_filter_succ_lt]
      have ih := koelink_relation_32 p q N j
      have hs : ∑ l ∈ univ.filter (fun l => j < l), towerGenerator p q (N + 1) l.succ =
          ⟨∑ l ∈ univ.filter (fun l => j < l), towerGenerator p q N l, 0⟩ := by
        simp only [towerGenerator, Fin.cases_succ]
        exact qa_sum_mk _ _
      rw [hs, halg, halg]
      simp only [towerGenerator, Fin.cases_succ, Fin.val_succ]
      rw [show N + 1 - 1 - (j.val + 1) = N - 1 - j.val by omega]
      ext
      · simp only [QuadraticAlgebra.re_mul, QuadraticAlgebra.re_add, QuadraticAlgebra.re_smul,
          QuadraticAlgebra.im_smul, QuadraticAlgebra.im_add, QuadraticAlgebra.im_mul]
        simp only [smul_zero, mul_zero, add_zero, zero_mul]
        rw [ih]
      · simp only [QuadraticAlgebra.im_mul, QuadraticAlgebra.re_add, QuadraticAlgebra.re_smul,
          QuadraticAlgebra.im_smul, QuadraticAlgebra.im_add, QuadraticAlgebra.re_mul]
        simp

/-! ### Theorem 7.1 -/

/-- The spectral coordinate `x_f = (p(1-q^(N-f)) - (1-q^f)) / (p(1-q^N))`. -/
noncomputable def koelinkX (N : ℕ) (p q : ℝ) (f : ℕ) : ℝ := (p * (1 - q ^ (N - f)) - (1 - q ^ f)) / (p * (1 - q ^ N))

theorem eval_recurrencePolynomial_succ {N : ℕ} (v : Coefficients N) (d : ℕ) (x : ℝ) (ha : v.a d ≠ 0) :
    v.a d * (recurrencePolynomial v (d + 1)).eval x =
      (x - v.b d) * (recurrencePolynomial v d).eval x -
        v.c d * (if d = 0 then 0 else (recurrencePolynomial v (d - 1)).eval x) := by
  have h1 : (polynomialPair v d).1 = if d = 0 then 0 else recurrencePolynomial v (d - 1) := by
    cases d with
    | zero => rfl
    | succ d => rfl
  have h2 : recurrencePolynomial v (d + 1) = Polynomial.C (v.a d)⁻¹ *
      ((Polynomial.X - Polynomial.C (v.b d)) * recurrencePolynomial v d -
        Polynomial.C (v.c d) * (polynomialPair v d).1) := rfl
  rw [h2, h1]
  split_ifs
  · simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_zero]
    field_simp
  · simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub, Polynomial.eval_X]
    field_simp

/-- **Koelink, Theorem 7.1**, transcribed: the coefficients of his recurrence, divided by `p(1-q^N)`, are those of
the array (eq:parameters) (`geometricCoefficients N p q`, `r = 1/p`), and for `q > 1` every solution `φ` of his
recurrence with `φ(0) = 1` is `φ(d) = R_d(x_f)` for `0 ≤ d ≤ N`. -/
theorem koelink_recurrence_71 (N : ℕ) (hN : 1 ≤ N) (p q : ℝ) (hp : 1 ≤ p) (hq : 1 < q) :
    let v := geometricCoefficients N p q
    (∀ d, d ≤ N →
      v.a d = p * q ^ d * (1 - q ^ (N - d)) / (p * (1 - q ^ N)) ∧
      v.b d = (1 - q ^ d) * (p - 1) / (p * (1 - q ^ N)) ∧
      v.c d = (1 - q ^ d) / (p * (1 - q ^ N))) ∧
    ∀ f, f ≤ N → ∀ φ : ℕ → ℝ, φ 0 = 1 →
      (∀ d, d < N → (p * (1 - q ^ (N - f)) - (1 - q ^ f)) * φ d =
        p * q ^ d * (1 - q ^ (N - d)) * φ (d + 1) + (1 - q ^ d) * (p - 1) * φ d + (1 - q ^ d) * φ (d - 1)) →
      ∀ d, d ≤ N → φ d = (recurrencePolynomial v d).eval (koelinkX N p q f) := by
  intro v
  have hp0 : 0 < p := by linarith
  have hq1 : q - 1 ≠ 0 := by linarith
  have hqN : 1 - q ^ N ≠ 0 := by
    have : 1 < q ^ N := one_lt_pow₀ hq (by omega)
    linarith
  have hQ : ∀ k, qInteger q k = (q ^ k - 1) / (q - 1) := fun k => by
    rw [eq_div_iff hq1]; exact qInteger_mul q k
  have hcoef : ∀ d, d ≤ N →
      v.a d = p * q ^ d * (1 - q ^ (N - d)) / (p * (1 - q ^ N)) ∧
      v.b d = (1 - q ^ d) * (p - 1) / (p * (1 - q ^ N)) ∧
      v.c d = (1 - q ^ d) / (p * (1 - q ^ N)) := by
    intro d _
    have hqN' : q ^ N - 1 ≠ 0 := fun h => hqN (by linarith)
    have hp' : p ≠ 0 := hp0.ne'
    simp only [v, geometricCoefficients, hQ]
    refine ⟨?_, ?_, ?_⟩ <;> field_simp <;> ring
  refine ⟨hcoef, fun f hf φ h0 hrec => ?_⟩
  set x := koelinkX N p q f
  -- both sequences satisfy `a_d s(d+1) = (x - b_d) s(d) - c_d s(d-1)` for `d < N`
  have ha : ∀ d, d < N → v.a d ≠ 0 := fun d hd => by
    rw [(hcoef d hd.le).1]
    have : q ^ d * (1 - q ^ (N - d)) ≠ 0 := by
      have h1 : 1 < q ^ (N - d) := one_lt_pow₀ hq (by omega)
      have h2 : 0 < q ^ d := by positivity
      nlinarith
    have : p * q ^ d * (1 - q ^ (N - d)) ≠ 0 := by
      rw [mul_assoc]; exact mul_ne_zero hp0.ne' this
    exact div_ne_zero this (mul_ne_zero hp0.ne' hqN)
  have hφ : ∀ d, d < N → v.a d * φ (d + 1) = (x - v.b d) * φ d - v.c d * (if d = 0 then 0 else φ (d - 1)) := by
    intro d hd
    obtain ⟨ea, eb, ec⟩ := hcoef d hd.le
    have hr := hrec d hd
    rw [ea, eb, ec]
    simp only [x, koelinkX]
    split_ifs with hd0
    · subst hd0; field_simp; simp at hr ⊢; linear_combination -hr
    · field_simp; linear_combination -hr
  have key : ∀ d, d + 1 ≤ N → φ d = (recurrencePolynomial v d).eval x ∧
      φ (d + 1) = (recurrencePolynomial v (d + 1)).eval x := by
    intro d
    induction d with
    | zero =>
      intro hN1
      have e0 : (recurrencePolynomial v 0).eval x = 1 := by simp [recurrencePolynomial, polynomialPair]
      refine ⟨by rw [h0, e0], ?_⟩
      have h1 := hφ 0 (by omega)
      have h2 := eval_recurrencePolynomial_succ v 0 x (ha 0 (by omega))
      simp only [if_pos rfl, mul_zero, sub_zero] at h1 h2
      rw [h0] at h1
      rw [e0] at h2
      exact mul_left_cancel₀ (ha 0 (by omega)) (h1.trans h2.symm)
    | succ d ih =>
      intro hd
      obtain ⟨i1, i2⟩ := ih (by omega)
      refine ⟨i2, ?_⟩
      have h1 := hφ (d + 1) (by omega)
      have h2 := eval_recurrencePolynomial_succ v (d + 1) x (ha (d + 1) (by omega))
      simp only [if_neg (Nat.succ_ne_zero d), Nat.add_sub_cancel] at h1 h2
      rw [i1, i2] at h1
      exact mul_left_cancel₀ (ha (d + 1) (by omega)) (h1.trans h2.symm)
  intro d hd
  rcases Nat.eq_zero_or_pos d with rfl | hpos
  · exact (key 0 hN).1
  · obtain ⟨e, rfl⟩ : ∃ e, d = e + 1 := ⟨d - 1, by omega⟩
    exact (key e hd).2

end Szkraw
