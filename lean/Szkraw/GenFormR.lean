/-! ### `e_n ≥ 0` -/

theorem eR_nonneg {a : ℕ} (ha : 3 ≤ a) (n : ℕ) : 0 ≤ eR a n := by
  have hA : (3 : ℝ) ≤ a := by exact_mod_cast ha
  rcases (show n = 0 ∨ n = 1 ∨ n = 2 ∨ n = 3 ∨ (4 ≤ n ∧ n ≤ a) ∨ a + 1 ≤ n by omega) with
    rfl | rfl | rfl | rfl | ⟨_h4, hna⟩ | hbig
  · unfold eR; small_vals; try norm_num
  · unfold eR; small_vals; poly_nonneg (a : ℝ) ≥ 3
  · unfold eR; small_vals; poly_nonneg (a : ℝ) ≥ 3
  · unfold eR; small_vals; poly_nonneg (a : ℝ) ≥ 3
  · obtain ⟨p, rfl⟩ : ∃ p, n = p + 4 := ⟨n - 4, by omega⟩
    obtain ⟨K, rfl⟩ : ∃ K, a = p + 4 + K := ⟨a - (p + 4), by omega⟩
    unfold eR
    rw [edgeCoef_ge4 _ _ (by omega : 4 ≤ p + 4)]
    simp only [show p + 4 - 1 = p + 3 by omega]
    rw [cfAD_one, cfAD_two, cfAD_ge2 (a := p + 4 + K) (n := p + 4) (by omega),
      cfAD_ge2 (a := p + 4 + K) (n := p + 3) (by omega), cfXp_one (by omega), cfXp_two' (by omega),
      cfXp_ge2 (a := p + 4 + K) (n := p + 4) (by omega), cfXp_ge2 (a := p + 4 + K) (n := p + 3) (by omega),
      cfH_ge3 (a := p + 4 + K) (n := p + 4) (by omega), cfH_ge3 (a := p + 4 + K) (n := p + 4 + 1) (by omega)]
    have := eR_arith (p : ℝ) (K : ℝ) _ _ _ _ _ (by positivity) (by positivity) (by positivity)
      (rel_cm p K) (rel_cp p K) (rel_d p K) (rel_e p K)
    push_cast at this ⊢; linarith
  · unfold eR
    rw [(cf_vanish ha hbig).2.2.2.2, (cf_vanish ha (by omega : a + 1 ≤ n + 1)).2.2.2.2]
    have := mul_nonneg (Nat.cast_nonneg a : (0 : ℝ) ≤ a)
      (edgeCoef_nonneg (cfAD_nonneg (a := a) (by omega)) (cfXp_nonneg (a := a) (by omega)) n)
    linarith

