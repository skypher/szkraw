import Szkraw.GenFormKpp

/-!
# The forms `R`, `R₂` (paper step (iii′)) and `K_a`, `Ψ`, `Q̂` (paper step (v)) of the key of Theorem 8.16

Each form is `≥ u₁ Σ_n e_n u_n` with `e_n ≥ 0`, for `a ≥ 6` (`R₂`), `a ≥ 5` (`K_a`) and `a ≥ 3` (the others).
The certificates at the generic index are generated by `runs/lean_plan/gen_arith.py`.
-/

set_option linter.unusedSectionVars false

namespace Szkraw

open Finset

/-- Close `0 ≤ P(x)` for a polynomial `P` whose coefficients are nonnegative after `x ↦ t + n`. -/
macro "poly_nonneg " x:term:max " ≥ " n:num : tactic =>
  `(tactic| (obtain ⟨t, ht, hta⟩ : ∃ t : ℝ, 0 ≤ t ∧ $x = t + $n := ⟨$x - $n, by linarith, by ring⟩
             rw [hta]
             linarith [ht, pow_nonneg ht 2, pow_nonneg ht 3, pow_nonneg ht 4, pow_nonneg ht 5, pow_nonneg ht 6]))

noncomputable def cfAD (a n : ℕ) : ℝ := (a.choose n : ℝ) - ((1 : ℕ).choose n : ℝ)
noncomputable def cfJ (a n : ℕ) : ℝ := cfXp a n - (if n = 1 then (a : ℝ) - 2 else 0)

section Values

variable {a : ℕ}

theorem cfAD_zero : cfAD a 0 = 0 := by simp [cfAD]
theorem cfAD_one : cfAD a 1 = (a : ℝ) - 1 := by simp [cfAD]
theorem cfAD_ge2 {n : ℕ} (hn : 2 ≤ n) : cfAD a n = a.choose n := by
  unfold cfAD; rw [choose_small_zero (by omega : 1 < n)]; ring
theorem cfAD_nonneg (ha : 1 ≤ a) (n : ℕ) : 0 ≤ cfAD a n := by
  rcases (show n = 0 ∨ n = 1 ∨ 2 ≤ n by omega) with rfl | rfl | hn
  · rw [cfAD_zero]
  · rw [cfAD_one]; have : (1 : ℝ) ≤ a := by exact_mod_cast ha
    linarith
  · rw [cfAD_ge2 hn]; positivity
theorem cfAD_vanish {n : ℕ} (hn : a + 1 ≤ n) (h2 : 2 ≤ n) : cfAD a n = 0 := by
  rw [cfAD_ge2 h2, choose_small_zero (by omega)]

theorem cfJ_zero : cfJ a 0 = 0 := by simp [cfJ, cfXp_zero]
theorem cfJ_one (ha : 1 ≤ a) : cfJ a 1 = 0 := by simp [cfJ, cfXp_one ha]
theorem cfJ_ge2 {n : ℕ} (hn : 2 ≤ n) : cfJ a n = (a - 1).choose n := by
  unfold cfJ; rw [cfXp_ge2 hn, if_neg (by omega)]; ring
theorem cfJ_nonneg (ha : 1 ≤ a) (n : ℕ) : 0 ≤ cfJ a n := by
  rcases (show n = 0 ∨ n = 1 ∨ 2 ≤ n by omega) with rfl | rfl | hn
  · rw [cfJ_zero]
  · rw [cfJ_one ha]
  · rw [cfJ_ge2 hn]; positivity
theorem cfJ_vanish {n : ℕ} (hn : a ≤ n) (h2 : 2 ≤ n) : cfJ a n = 0 := by
  rw [cfJ_ge2 h2, choose_small_zero (by omega)]

/-! Closed values at the small indices. -/

theorem cfAD_two : cfAD a 2 = (a : ℝ) * ((a : ℝ) - 1) / 2 := by rw [cfAD_ge2 le_rfl, cast_choose_two]
theorem cfAD_three (ha : 2 ≤ a) : cfAD a 3 = (a : ℝ) * ((a : ℝ) - 1) * ((a : ℝ) - 2) / 6 := by
  rw [cfAD_ge2 (by norm_num), cast_choose_three a ha]
theorem pred_two (ha : 1 ≤ a) : (((a - 1).choose 2 : ℕ) : ℝ) = ((a : ℝ) - 1) * ((a : ℝ) - 2) / 2 := by
  rw [cast_choose_two, cast_pred ha]; ring
theorem pred_three (ha : 3 ≤ a) :
    (((a - 1).choose 3 : ℕ) : ℝ) = ((a : ℝ) - 1) * ((a : ℝ) - 2) * ((a : ℝ) - 3) / 6 := by
  rw [cast_choose_three (a - 1) (by omega), cast_pred (by omega)]; ring
theorem cfXp_two' (ha : 1 ≤ a) : cfXp a 2 = ((a : ℝ) - 1) * ((a : ℝ) - 2) / 2 := by
  rw [cfXp_ge2 le_rfl, pred_two ha]
theorem cfXp_three' (ha : 3 ≤ a) : cfXp a 3 = ((a : ℝ) - 1) * ((a : ℝ) - 2) * ((a : ℝ) - 3) / 6 := by
  rw [cfXp_ge2 (by norm_num), pred_three ha]
theorem cfXpp_two' (ha : 1 ≤ a) : cfXpp a 2 = ((a : ℝ) - 1) * ((a : ℝ) - 2) / 2 := by
  rw [cfXpp_pos (by norm_num), pred_two ha]
theorem cfXpp_three' (ha : 3 ≤ a) : cfXpp a 3 = ((a : ℝ) - 1) * ((a : ℝ) - 2) * ((a : ℝ) - 3) / 6 := by
  rw [cfXpp_pos (by norm_num), pred_three ha]
theorem cfJ_two' (ha : 1 ≤ a) : cfJ a 2 = ((a : ℝ) - 1) * ((a : ℝ) - 2) / 2 := by
  rw [cfJ_ge2 le_rfl, pred_two ha]
theorem cfJ_three' (ha : 3 ≤ a) : cfJ a 3 = ((a : ℝ) - 1) * ((a : ℝ) - 2) * ((a : ℝ) - 3) / 6 := by
  rw [cfJ_ge2 (by norm_num), pred_three ha]
theorem cfY_two' : cfY a 2 = (a : ℝ) * ((a : ℝ) - 1) / 2 := by rw [cfY_ge2 le_rfl, cast_choose_two]
theorem cfY_three' (ha : 2 ≤ a) : cfY a 3 = (a : ℝ) * ((a : ℝ) - 1) * ((a : ℝ) - 2) / 6 := by
  rw [cfY_ge2 (by norm_num), cast_choose_three a ha]
theorem cfYp_two' : cfYp a 2 = (a : ℝ) * ((a : ℝ) - 1) / 2 - ((a : ℝ) - 1) := by rw [cfYp_two, cast_choose_two]
theorem cfYp_three' (ha : 2 ≤ a) : cfYp a 3 = (a : ℝ) * ((a : ℝ) - 1) * ((a : ℝ) - 2) / 6 := by
  rw [cfYp_ge3 le_rfl, cast_choose_three a ha]
theorem cfH_three' (ha : 2 ≤ a) : cfH a 3 = (a : ℝ) * ((a : ℝ) - 1) * ((a : ℝ) - 2) / 6 := by
  rw [cfH_ge3 le_rfl, cast_choose_three a ha]; push_cast; ring
theorem cfH_four' (ha : 3 ≤ a) :
    cfH a 4 = 2 * ((a : ℝ) * ((a : ℝ) - 1) * ((a : ℝ) - 2) * ((a : ℝ) - 3) / 24) := by
  rw [cfH_ge3 (by norm_num), cast_choose_four a ha]; push_cast; ring

end Values

set_option hygiene false in
/-- Evaluate the coefficient sequences at the indices `0, …, 4` (needs `3 ≤ a` in scope). -/
macro "small_vals" : tactic =>
  `(tactic| (simp only [edgeCoef_zero, edgeCoef_one, edgeCoef_two, edgeCoef_three, cfAD_zero, cfAD_one, cfAD_two,
    cfAD_three (a := a) (by omega), cfXp_zero, cfXp_one (a := a) (by omega), cfXp_two' (a := a) (by omega),
    cfXp_three' (a := a) (by omega), cfXpp_zero, cfXpp_one (a := a) (by omega), cfXpp_two' (a := a) (by omega),
    cfXpp_three' (a := a) (by omega), cfJ_zero, cfJ_one (a := a) (by omega), cfJ_two' (a := a) (by omega),
    cfJ_three' (a := a) (by omega), cfY_zero, cfY_one, cfY_two', cfY_three' (a := a) (by omega), cfYp_zero, cfYp_one,
    cfYp_two', cfYp_three' (a := a) (by omega), cfH_le2 (a := a) (n := 0) (by norm_num),
    cfH_le2 (a := a) (n := 1) (by norm_num), cfH_le2 (a := a) (n := 2) (by norm_num),
    cfH_three' (a := a) (by omega), cfH_four' (a := a) (by omega)]; push_cast))

/-! ### Bridges and the two negative parts -/

theorem AD_lf (f : ℕ → ℝ) {a : ℕ} (ha : 3 ≤ a) : dd f a - dd f 1 = lf (a + 1) (cfAD a) f := by
  rw [dd_lf f (m := a) (R := a + 1) (by omega), dd_lf f (m := 1) (R := a + 1) (by omega)]
  unfold lf cfAD; rw [← sum_sub_distrib]; exact sum_congr rfl fun n _ => by ring

theorem J_lf (f : ℕ → ℝ) {a : ℕ} (ha : 3 ≤ a) :
    dd f (a - 1) - dd f 1 - ((a : ℝ) - 2) * f 1 = lf (a + 1) (cfJ a) f := by
  rw [Xp_lf f ha]
  unfold lf cfJ
  simp only [sub_mul, sum_sub_distrib, ite_mul, zero_mul]
  rw [sum_ite_eq', if_pos (mem_range.2 (by omega))]

theorem Hstar_lf2 (f : ℕ → ℝ) {a : ℕ} (ha : 3 ≤ a) : Hstar f a = lf (a + 2) (cfH a) f := by
  rw [Hstar_lf]; exact lf_extend (by omega) (fun n hn => (cf_vanish (a := a) ha hn).2.2.2.2)

theorem nuC_lf (f : ℕ → ℝ) {a : ℕ} (ha : 3 ≤ a) {k : ℕ} (hk : 1 ≤ k) :
    nuC f a k = lf (a + 2) (fun n => cfH a (n + 1) * ((n : ℝ) + 1) * (n.choose (k - 1) : ℝ)) f := by
  have h1 : nuC f a k = lf (a + 1) (fun n => cfH a (n + 1) * ((n : ℝ) + 1) * (n.choose (k - 1) : ℝ)) f := by
    unfold nuC lf cfH
    conv_lhs => rw [sum_range_succ']
    conv_rhs => rw [sum_range_succ]
    have z : ((a.choose (a + 1) : ℕ) : ℝ) = 0 := choose_small_zero (by omega)
    simp only [z, Nat.cast_zero, zero_mul, mul_zero, add_zero]
    refine sum_congr rfl fun i _ => ?_
    rw [if_pos hk]; simp only [Nat.add_sub_cancel]; push_cast; ring
  rw [h1]
  exact lf_extend (by omega) (fun n hn => by
    simp only [(cf_vanish (a := a) ha (n := n + 1) (by omega)).2.2.2.2, zero_mul])

theorem zetaC_lf (f : ℕ → ℝ) {a : ℕ} (ha : 3 ≤ a) (k : ℕ) :
    zetaC f a k = lf (a + 2) (fun n => cfH a n * (n.choose k : ℝ)) f := by
  have h1 : zetaC f a k = lf (a + 1) (fun n => cfH a n * (n.choose k : ℝ)) f := by
    unfold zetaC lf cfH; exact sum_congr rfl fun n _ => by ring
  rw [h1]
  exact lf_extend (by omega) (fun n hn => by simp only [(cf_vanish (a := a) ha hn).2.2.2.2, zero_mul])

theorem u0H_le (f : ℕ → ℝ) (hf : LCNZ f) {a : ℕ} (ha : 3 ≤ a) :
    f 0 * lf (a + 1) (cfH a) f ≤ f 1 * lf (a + 2) (fun n => cfH a (n + 1)) f := by
  have N0 := hf.u0_lf a (cfH a) cfH_nonneg (cfH_le2 (by omega))
  rwa [lf_extend (R := a) (S := a + 2) (by omega)
    (fun n hn => (cf_vanish (a := a) ha (n := n + 1) (by omega)).2.2.2.2)] at N0

theorem DH_le (f : ℕ → ℝ) (hf : LCNZ f) {a : ℕ} (ha : 3 ≤ a) :
    (f 0 + f 1) * lf (a + 1) (cfH a) f ≤ f 1 * lf (a + 2) (fun n => cfH a n + cfH a (n + 1)) f := by
  have N := u0H_le f hf ha
  have hH : lf (a + 1) (cfH a) f = lf (a + 2) (cfH a) f :=
    lf_extend (by omega) (fun n hn => (cf_vanish (a := a) ha hn).2.2.2.2)
  rw [lf_add, ← hH]; linarith

/-! ### The forms and their edge bounds -/

noncomputable def eR (a n : ℕ) : ℝ := (a : ℝ) * edgeCoef (cfAD a) (cfXp a) n - 8 * (cfH a n + cfH a (n + 1))

noncomputable def eR2 (a n : ℕ) : ℝ :=
  ((a : ℝ) - 2) * edgeCoef (cfAD a) (cfXpp a) n - 4 * (a : ℝ) * (cfH a n + cfH a (n + 1))

noncomputable def eKa (a n : ℕ) : ℝ := ((a : ℝ) - 1) * ePos a n - 4 * (a : ℝ) * (cfH a n + cfH a (n + 1))

noncomputable def ePsi (a n : ℕ) : ℝ :=
  (a : ℝ) * edgeCoef (cfAD a) (cfJ a) n - ((a : ℝ) - 1) * ((a : ℝ) - 2) / 2 * (cfY a n + cfYp a n)

noncomputable def eQhat (a n : ℕ) : ℝ :=
  ((a : ℝ) - 1) * ePos a n + (2 * ((n : ℝ) + 1) ^ 2 - 4 * (a : ℝ)) * cfH a (n + 1) -
    4 * ((a : ℝ) + (a : ℝ) * ((a : ℝ) - 1) / 2 - (n : ℝ) - (n : ℝ) * ((n : ℝ) - 1) / 2) * cfH a n

/-- `R = β₁ X' - 8 D H_* ≥ u₁ Σ e_n u_n`, with `β₁ = a (A - D)`. -/
theorem R_ge (f : ℕ → ℝ) (hf : LCNZ f) {a : ℕ} (ha : 3 ≤ a) :
    f 1 * lf (a + 2) (eR a) f ≤
      (a : ℝ) * (lf (a + 1) (cfAD a) f * lf (a + 1) (cfXp a) f) - 8 * ((f 0 + f 1) * lf (a + 1) (cfH a) f) := by
  have E := hf.edge_prod (R := a + 1) (by omega) (x := cfAD a) (y := cfXp a) (cfAD_nonneg (by omega))
    (cfXp_nonneg (by omega)) cfAD_zero cfXp_zero (fun n hn => cfAD_vanish hn (by omega))
    (fun n hn => (cf_vanish (a := a) ha hn).2.1)
  have N := DH_le f hf ha
  have hs : lf (a + 2) (eR a) f = (a : ℝ) * lf (a + 2) (edgeCoef (cfAD a) (cfXp a)) f -
      8 * lf (a + 2) (fun n => cfH a n + cfH a (n + 1)) f := by
    unfold lf eR; simp only [mul_sum, ← sum_sub_distrib]; exact sum_congr rfl fun n _ => by ring
  rw [hs]; linarith [mul_le_mul_of_nonneg_left E (Nat.cast_nonneg a : (0 : ℝ) ≤ a)]

/-- `R₂ = (a-2)(A - D) X'' - 4a D H_* ≥ u₁ Σ e_n u_n`. -/
theorem R2_ge (f : ℕ → ℝ) (hf : LCNZ f) {a : ℕ} (ha : 3 ≤ a) :
    f 1 * lf (a + 2) (eR2 a) f ≤
      ((a : ℝ) - 2) * (lf (a + 1) (cfAD a) f * lf (a + 1) (cfXpp a) f) -
        4 * (a : ℝ) * ((f 0 + f 1) * lf (a + 1) (cfH a) f) := by
  have E := hf.edge_prod (R := a + 1) (by omega) (x := cfAD a) (y := cfXpp a) (cfAD_nonneg (by omega))
    cfXpp_nonneg cfAD_zero cfXpp_zero (fun n hn => cfAD_vanish hn (by omega))
    (fun n hn => cfXpp_vanish (by omega) (by omega))
  have N := DH_le f hf ha
  have hs : lf (a + 2) (eR2 a) f = ((a : ℝ) - 2) * lf (a + 2) (edgeCoef (cfAD a) (cfXpp a)) f -
      4 * (a : ℝ) * lf (a + 2) (fun n => cfH a n + cfH a (n + 1)) f := by
    unfold lf eR2; simp only [mul_sum, ← sum_sub_distrib]; exact sum_congr rfl fun n _ => by ring
  have hA : (3 : ℝ) ≤ a := by exact_mod_cast ha
  rw [hs]
  nlinarith [mul_le_mul_of_nonneg_left E (by linarith : (0 : ℝ) ≤ (a : ℝ) - 2),
    mul_le_mul_of_nonneg_left N (by linarith : (0 : ℝ) ≤ 4 * (a : ℝ))]

/-- `K_a = (a-1)(Y'X'' + YX') - 4a D H_* ≥ u₁ Σ e_n u_n`. -/
theorem Ka_ge (f : ℕ → ℝ) (hf : LCNZ f) {a : ℕ} (ha : 3 ≤ a) :
    f 1 * lf (a + 2) (eKa a) f ≤
      ((a : ℝ) - 1) * (lf (a + 1) (cfYp a) f * lf (a + 1) (cfXpp a) f +
        lf (a + 1) (cfY a) f * lf (a + 1) (cfXp a) f) - 4 * (a : ℝ) * ((f 0 + f 1) * lf (a + 1) (cfH a) f) := by
  have P := pos_edge f hf ha
  have N := DH_le f hf ha
  have hs : lf (a + 2) (eKa a) f = ((a : ℝ) - 1) * lf (a + 2) (ePos a) f -
      4 * (a : ℝ) * lf (a + 2) (fun n => cfH a n + cfH a (n + 1)) f := by
    unfold lf eKa; simp only [mul_sum, ← sum_sub_distrib]; exact sum_congr rfl fun n _ => by ring
  have hA : (3 : ℝ) ≤ a := by exact_mod_cast ha
  rw [hs]
  nlinarith [mul_le_mul_of_nonneg_left P (by linarith : (0 : ℝ) ≤ (a : ℝ) - 1),
    mul_le_mul_of_nonneg_left N (by linarith : (0 : ℝ) ≤ 4 * (a : ℝ))]

/-- `Ψ = a (A - D) J - C(a-1,2) u₁ (Y + Y') ≥ u₁ Σ e_n u_n`. -/
theorem Psi_ge (f : ℕ → ℝ) (hf : LCNZ f) {a : ℕ} (ha : 3 ≤ a) :
    f 1 * lf (a + 2) (ePsi a) f ≤
      (a : ℝ) * (lf (a + 1) (cfAD a) f * lf (a + 1) (cfJ a) f) -
        ((a : ℝ) - 1) * ((a : ℝ) - 2) / 2 * (f 1 * (lf (a + 1) (cfY a) f + lf (a + 1) (cfYp a) f)) := by
  have hv := fun n (hn : a + 1 ≤ n) => cf_vanish (a := a) ha hn
  have E := hf.edge_prod (R := a + 1) (by omega) (x := cfAD a) (y := cfJ a) (cfAD_nonneg (by omega))
    (cfJ_nonneg (by omega)) cfAD_zero cfJ_zero (fun n hn => cfAD_vanish hn (by omega))
    (fun n hn => cfJ_vanish (by omega) (by omega))
  have hY : lf (a + 1) (cfY a) f + lf (a + 1) (cfYp a) f = lf (a + 2) (fun n => cfY a n + cfYp a n) f := by
    rw [lf_add, lf_extend (R := a + 1) (S := a + 2) (by omega) (fun n hn => (hv n hn).2.2.1),
      lf_extend (R := a + 1) (S := a + 2) (by omega) (fun n hn => (hv n hn).2.2.2.1)]
  have hs : lf (a + 2) (ePsi a) f = (a : ℝ) * lf (a + 2) (edgeCoef (cfAD a) (cfJ a)) f -
      ((a : ℝ) - 1) * ((a : ℝ) - 2) / 2 * lf (a + 2) (fun n => cfY a n + cfYp a n) f := by
    unfold lf ePsi; simp only [mul_sum, ← sum_sub_distrib]; exact sum_congr rfl fun n _ => by ring
  rw [hs, hY]; linarith [mul_le_mul_of_nonneg_left E (Nat.cast_nonneg a : (0 : ℝ) ≤ a)]

/-- `Q̂ = (a-1)(Y'X'' + YX') - 4a u₀ H_* + u₁ (2ν₁ + 2ν₂ - 4Z₁ - 4Z₂) ≥ u₁ Σ e_n u_n`. -/
theorem Qhat_ge (f : ℕ → ℝ) (hf : LCNZ f) {a : ℕ} (ha : 3 ≤ a) :
    f 1 * lf (a + 2) (eQhat a) f ≤
      ((a : ℝ) - 1) * (lf (a + 1) (cfYp a) f * lf (a + 1) (cfXpp a) f +
        lf (a + 1) (cfY a) f * lf (a + 1) (cfXp a) f) - 4 * (a : ℝ) * (f 0 * Hstar f a) +
        f 1 * (2 * nuC f a 1 + 2 * nuC f a 2 - 4 * ((a : ℝ) * Hstar f a - zetaC f a 1) -
          4 * ((a : ℝ) * ((a : ℝ) - 1) / 2 * Hstar f a - zetaC f a 2)) := by
  have P := pos_edge f hf ha
  have N := u0H_le f hf ha
  rw [← Hstar_lf] at N
  have hν : nuC f a 1 + nuC f a 2 = lf (a + 2) (fun n => cfH a (n + 1) * ((n : ℝ) + 1) ^ 2) f := by
    rw [nuC_lf f ha le_rfl, nuC_lf f ha (by norm_num), ← lf_add]
    unfold lf; exact sum_congr rfl fun n _ => by
      simp only [Nat.sub_self, Nat.choose_zero_right, show (2 : ℕ) - 1 = 1 from rfl, Nat.choose_one_right]
      push_cast; ring
  have hζ : zetaC f a 1 + zetaC f a 2 =
      lf (a + 2) (fun n => cfH a n * ((n : ℝ) + (n : ℝ) * ((n : ℝ) - 1) / 2)) f := by
    rw [zetaC_lf f ha 1, zetaC_lf f ha 2, ← lf_add]
    unfold lf; exact sum_congr rfl fun n _ => by simp only [Nat.choose_one_right, cast_choose_two]; ring
  have hs : lf (a + 2) (eQhat a) f = ((a : ℝ) - 1) * lf (a + 2) (ePos a) f +
      2 * lf (a + 2) (fun n => cfH a (n + 1) * ((n : ℝ) + 1) ^ 2) f -
      4 * (a : ℝ) * lf (a + 2) (fun n => cfH a (n + 1)) f -
      4 * ((a : ℝ) + (a : ℝ) * ((a : ℝ) - 1) / 2) * lf (a + 2) (cfH a) f +
      4 * lf (a + 2) (fun n => cfH a n * ((n : ℝ) + (n : ℝ) * ((n : ℝ) - 1) / 2)) f := by
    unfold lf eQhat; simp only [mul_sum, ← sum_sub_distrib, ← sum_add_distrib]
    exact sum_congr rfl fun n _ => by ring
  have hA : (3 : ℝ) ≤ a := by exact_mod_cast ha
  rw [hs, ← hν, ← hζ, ← Hstar_lf2 f ha]
  nlinarith [mul_le_mul_of_nonneg_left P (by linarith : (0 : ℝ) ≤ (a : ℝ) - 1),
    mul_le_mul_of_nonneg_left N (by linarith : (0 : ℝ) ≤ 4 * (a : ℝ))]

/-! ### Generic certificates (generated by `runs/lean_plan/gen_arith.py`) -/

theorem eR_arith (p K c cm cp d e : ℝ) (hp : 0 ≤ p) (hK : 0 ≤ K) (hc : 0 ≤ c)
    (h1 : cm * (K + 1) = c * (p + 4)) (h2 : cp * (p + 5) = c * K) (h3 : d * (p + 4 + K) = c * (p + 4))
    (h4 : e * (p + 4 + K) = c * K) :
    0 ≤ (p + 4 + K) * (((p + 4 + K) - 1) * e + (p + 4 + K) * ((p + 4 + K) - 1) / 2 * d + ((p + 4 + K) - 2) * c + ((p + 4 + K) - 1) * ((p + 4 + K) - 2) / 2 * cm) - 8 * ((p + 4 - 2) * c) - 8 * ((p + 4 + 1 - 2) * cp) := by
  have hK1 : 0 < K + 1 := by linarith
  have hp5 : 0 < p + 5 := by linarith
  have ha : 0 < p + 4 + K := by linarith
  have ecm : cm = c * (p + 4) / (K + 1) := by field_simp; linarith
  have ecp : cp = c * K / (p + 5) := by field_simp; linarith
