import Szkraw.CubicB

/-!
# Theorem 8.17: the `E` detour (eq. `cubic-E`)

`3(n-1) c_{ℓ+1} e_{n+2}(ℓ) ≤ (n+1)(n+2) (φ₂(ℓ) + (n/3) φ₃(ℓ)) e_n(ℓ+1)` for `n ≥ 3`, with `r σ ≤ t τ`.
Bilinear in `(r,t,τ,σ) × (τ,σ)`; every coefficient form (with `κ_{tτ} + κ_{rσ}` combined) is a sum of tail sums times
log-concavity steps, as for the `B` detour. Certificates generated by `runs/lean_plan/gen_cubicE.py`.
-/

set_option linter.unusedSectionVars false
set_option maxHeartbeats 4000000

namespace Szkraw

open Finset

/-- `e_n(ℓ)` in terms of `v k = f_k(ℓ)`. -/
noncomputable def eCv (τ σ : ℝ) (ℓ n : ℕ) (v : ℕ → ℝ) : ℝ :=
  (n.choose 2 : ℝ) * (τ + σ * ℓ) * v (n - 2) + σ * (n.choose 3 : ℝ) * (3 * v (n - 1) + 3 * v (n - 2) + v (n - 3))

theorem eC_eq (τ σ : ℝ) (ν : ℕ → ℝ) (ℓ n : ℕ) : eC τ σ ν ℓ n = eCv τ σ ℓ n (Szkraw.iterShift ν ℓ) := rfl

theorem eCv_lin (τ σ : ℝ) (ℓ n : ℕ) (v : ℕ → ℝ) : eCv τ σ ℓ n v = τ * eCv 1 0 ℓ n v + σ * eCv 0 1 ℓ n v := by
  unfold eCv; ring

theorem eCv_add3 (τ σ : ℝ) (ℓ k : ℕ) (v : ℕ → ℝ) :
    eCv τ σ ℓ (k + 3) v = ((k + 3).choose 2 : ℝ) * (τ + σ * ℓ) * v (k + 1) +
      σ * ((k + 3).choose 3 : ℝ) * (3 * v (k + 2) + 3 * v (k + 1) + v k) := by
  unfold eCv
  rw [show k + 3 - 1 = k + 2 by omega, show k + 3 - 2 = k + 1 by omega, show k + 3 - 3 = k by omega]

theorem PhiC_three (r t τ σ : ℝ) (ℓ : ℕ) (v : ℕ → ℝ) :
    PhiC r t τ σ ℓ 3 v = rhoC r t τ σ (ℓ + 3) * v 3 + 3 * drhoC t τ σ (ℓ + 2) * v 2 +
      3 * d2rhoC τ σ (ℓ + 1) * v 1 + σ * v 0 := by
  unfold PhiC; simp [Nat.choose]

