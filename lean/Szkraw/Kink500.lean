import Szkraw.Kink500Chunk1
import Szkraw.Kink500Chunk2
import Szkraw.Kink500Chunk3
import Szkraw.Kink500Chunk4

/-!
# P3, Section 9: the one-kink counterexample with `N = 500` (`r = 1/10`)

Constant ratio `r = 1/10`, profile with `450` unit increments followed by `50` increments `11/10`: every admissible
array with this profile and ratio has `g(500,500;500) < 0`. The column entry `H_500(500)` is computed on the
windows of `WindowColumn.lean` in four chunks, checked in the kernel against the stated intermediate states
(`Kink500Chunk1.lean`, …, `Kink500Chunk4.lean`, data generated by `runs/kink500/gen_ckpt.py`).
-/

namespace Szkraw

open ColCheck

theorem k5_lengths : k5A.length = 500 + 1 ∧ k5B.length = 500 + 1 ∧ k5C.length = 500 + 1 := by
  simp [k5A, k5B, k5C, rA, rB, rC]

/-- `H_500(500) < 0` for column `500` of the `N = 500` example. -/
theorem kink500_corner : eG (ccol k5A k5B k5C 500 500 500).2 500 < 0 := by
  obtain ⟨hA, hB, hC⟩ := k5_lengths
  rw [← witer_corner hA hB hC (by norm_num)]
  have h1 := witer_add k5A k5B k5C 500 0 150 350 (winit 500)
  have h2 := witer_add k5A k5B k5C 500 150 100 250 kink500ck150
  have h3 := witer_add k5A k5B k5C 500 250 100 150 kink500ck250
  rw [kink500_chunk1] at h1
  rw [kink500_chunk2] at h2
  rw [kink500_chunk3] at h3
  have e : witer k5A k5B k5C 500 0 500 (winit 500) = witer k5A k5B k5C 500 350 150 kink500ck350 := by
    rw [show (500 : ℕ) = 150 + 350 by norm_num] at h1 ⊢
    rw [h1, show (0 : ℕ) + 150 = 150 by norm_num, show (350 : ℕ) = 100 + 250 by norm_num, h2,
      show (150 : ℕ) + 100 = 250 by norm_num, show (250 : ℕ) = 100 + 150 by norm_num, h3]
  rw [e]
  exact kink500_chunk4

/-- **P3, Section 9 table**: `r = 1/10`, `N = 500`, `m = 450`, `δ = 1/10`. -/
theorem kink500_1_10_fails : KinkFails (1 / 10) (1 / 10) 500 450 := by
  have hpk : psum (kinkZ 450 1 10) = kinkDn 450 1 10 := funext (psum_kinkZ 450 1 10)
  have hneg : eG (ccol (rA (psum (kinkZ 450 1 10)) 10 500) (rB (psum (kinkZ 450 1 10)) (fun _ => 1) 10 500)
      (rC (psum (kinkZ 450 1 10)) (fun _ => 1) 500) 500 500 500).2 500 < 0 := by
    rw [hpk]; exact kink500_corner
  have h := incProfile_example (kinkZ 450 1 10) 10 (kinkInc 450 (((1 : ℤ) : ℝ) / ((10 : ℤ) : ℝ))) 1 10 (1 / 10) 500
    (by norm_num) (fun j _ => kinkInc_eq 450 1 10 (by norm_num) j) (by norm_num) (by norm_num) (by norm_num)
    (fun i hi => by rw [hpk]; unfold kinkDn; split_ifs <;> push_cast <;> omega)
    (fun i hi => by rw [hpk]; unfold kinkDn; split_ifs <;> push_cast <;> omega)
    (fun _ _ => by norm_num)
    (fun i hi => by rw [hpk]; unfold kinkDn; split_ifs <;> push_cast <;> omega)
    500 500 500 le_rfl (by norm_num) (by norm_num) hneg
  norm_num at h
  exact h

end Szkraw
