import Szkraw.GenM0s

/-!
# Windows `3 ≤ a ≤ 5` of the key of Theorem 8.16 (paper step (vii))

`M_{1,m} + M_{m,1} ≥ 0` for `3 ≤ a ≤ 5`, `2 ≤ m ≤ a`, and `S_{2,0} = M_{0,2} + M_{1,1} ≥ 0` for `a ∈ {3, 4}`, each an
exact combination of `u_k (u_{i+1} u_{j-1} - u_i u_j)` and monomials (generated by `runs/lean_plan/window_cert.py`).
-/

set_option linter.unusedSectionVars false

namespace Szkraw

open Finset

theorem dd_eval (f : ℕ → ℝ) (n : ℕ) : dd f n = ∑ k ∈ range (n + 1), (n.choose k : ℝ) * f k := by
  rw [dd_lf f (m := n) (R := n + 1) (by omega)]; rfl

/-- Expand `MC f a k m` for numerals `a, k, m` into a polynomial in `f 0, …, f a`. -/
macro "win_expand" : tactic =>
  `(tactic| (simp only [MC, betaC, beta'C, chiC, chi'C, deltaC, nuC, zetaC, Hstar, wgtH, dd_eval,
    Finset.sum_range_succ, Finset.sum_range_zero]; norm_num [Nat.choose]))

theorem win_MM1_3_2 {f : ℕ → ℝ} (hf : LCNZ f) : 0 ≤ MC f 3 1 2 + MC f 3 2 1 := by
  have g0 : 0 ≤ f 0 * (f 1 * f 1 - f 0 * f 2) := mul_nonneg (hf.1 0) (sub_nonneg.2 (hf.step (x := 0) (y := 0) (by norm_num)))
  have g1 : 0 ≤ f 0 * (f 1 * f 2 - f 0 * f 3) := mul_nonneg (hf.1 0) (sub_nonneg.2 (hf.step (x := 0) (y := 1) (by norm_num)))
  have g2 : 0 ≤ f 0 * (f 2 * f 2 - f 1 * f 3) := mul_nonneg (hf.1 0) (sub_nonneg.2 (hf.step (x := 1) (y := 1) (by norm_num)))
  have g3 : 0 ≤ f 1 * (f 1 * f 1 - f 0 * f 2) := mul_nonneg (hf.1 1) (sub_nonneg.2 (hf.step (x := 0) (y := 0) (by norm_num)))
  have g4 : 0 ≤ f 1 * (f 2 * f 2 - f 1 * f 3) := mul_nonneg (hf.1 1) (sub_nonneg.2 (hf.step (x := 1) (y := 1) (by norm_num)))
  have g5 : 0 ≤ f 2 * (f 1 * f 1 - f 0 * f 2) := mul_nonneg (hf.1 2) (sub_nonneg.2 (hf.step (x := 0) (y := 0) (by norm_num)))
  have g6 : 0 ≤ f 3 * (f 1 * f 1 - f 0 * f 2) := mul_nonneg (hf.1 3) (sub_nonneg.2 (hf.step (x := 0) (y := 0) (by norm_num)))
  have g7 : 0 ≤ f 3 * (f 1 * f 2 - f 0 * f 3) := mul_nonneg (hf.1 3) (sub_nonneg.2 (hf.step (x := 0) (y := 1) (by norm_num)))
  have g8 : 0 ≤ f 0 * f 0 * f 3 := mul_nonneg (mul_nonneg (hf.1 0) (hf.1 0)) (hf.1 3)
  have g9 : 0 ≤ f 0 * f 1 * f 1 := mul_nonneg (mul_nonneg (hf.1 0) (hf.1 1)) (hf.1 1)
  have g10 : 0 ≤ f 0 * f 2 * f 2 := mul_nonneg (mul_nonneg (hf.1 0) (hf.1 2)) (hf.1 2)
  have g11 : 0 ≤ f 0 * f 3 * f 3 := mul_nonneg (mul_nonneg (hf.1 0) (hf.1 3)) (hf.1 3)
  have g12 : 0 ≤ f 1 * f 1 * f 3 := mul_nonneg (mul_nonneg (hf.1 1) (hf.1 1)) (hf.1 3)
  have g13 : 0 ≤ f 1 * f 3 * f 3 := mul_nonneg (mul_nonneg (hf.1 1) (hf.1 3)) (hf.1 3)
  have g14 : 0 ≤ f 2 * f 2 * f 2 := mul_nonneg (mul_nonneg (hf.1 2) (hf.1 2)) (hf.1 2)
  have g15 : 0 ≤ f 2 * f 2 * f 3 := mul_nonneg (mul_nonneg (hf.1 2) (hf.1 2)) (hf.1 3)
  have g16 : 0 ≤ f 2 * f 3 * f 3 := mul_nonneg (mul_nonneg (hf.1 2) (hf.1 3)) (hf.1 3)
  win_expand
  linarith

