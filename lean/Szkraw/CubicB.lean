import Szkraw.CubicSetting

/-!
# Theorem 8.17: the `B` detour (eq. `cubic-B`)

`8(n-1) c_{ℓ+1} φ_{n+2}(ℓ) ≤ (n+1)(n+2) φ₂(ℓ) φ_n(ℓ+1)` for `n ≥ 2`, `(ℓ,n) ≠ (0,2)`, with `r σ ≤ t τ`.
The part with `t = σ = 0` is `quadB_seq` (Theorem 8.11). The rest is grouped by index sum; within a group the
monomials `v_a v_{s-a}` increase with `a` (log-concavity), and every tail sum of coefficients is
`Pos + (tτ - rσ) Pm` with `Pos`, `Pm` having nonnegative coefficients. The certificates are generated by
`runs/lean_plan/gen_cubicB.py`.
-/

set_option linter.unusedSectionVars false
set_option maxHeartbeats 4000000

namespace Szkraw

open Finset

theorem rhoQ_zero_eq (r τ : ℝ) (x : ℕ) : rhoQ r 0 τ (x : ℝ) = rhoC r 0 τ 0 x := by
  unfold rhoQ rhoC; rw [choose2_real]; ring

theorem PhiQ_zero_eq (r τ : ℝ) (x k : ℕ) (v : ℕ → ℝ) : PhiQ r 0 τ (x : ℝ) k v = PhiC r 0 τ 0 x k v := by
  unfold PhiQ PhiC rhoQ drhoQ rhoC drhoC d2rhoC
  rcases k with _ | k
  · simp [choose2_real]
  · rw [show k + 1 - 1 = k by omega, choose2_real (x + (k + 1)), choose2_real (k + 1)]; push_cast; ring

theorem PhiC_two (r t τ σ : ℝ) (ℓ : ℕ) (v : ℕ → ℝ) :
    PhiC r t τ σ ℓ 2 v = rhoC r t τ σ (ℓ + 2) * v 2 + 2 * drhoC t τ σ (ℓ + 1) * v 1 + d2rhoC τ σ ℓ * v 0 := by
  unfold PhiC; simp [Nat.choose]

theorem rhoC_lin (r t τ σ : ℝ) (x : ℕ) :
    rhoC r t τ σ x = r * rhoC 1 0 0 0 x + t * rhoC 0 1 0 0 x + τ * rhoC 0 0 1 0 x + σ * rhoC 0 0 0 1 x := by
  unfold rhoC; ring

theorem PhiC_lin (r t τ σ : ℝ) (ℓ n : ℕ) (v : ℕ → ℝ) :
    PhiC r t τ σ ℓ n v = r * PhiC 1 0 0 0 ℓ n v + t * PhiC 0 1 0 0 ℓ n v + τ * PhiC 0 0 1 0 ℓ n v +
      σ * PhiC 0 0 0 1 ℓ n v := by
  unfold PhiC rhoC drhoC d2rhoC; ring

theorem PhiC_nonneg {r t τ σ : ℝ} (hr : 0 ≤ r) (ht : 0 ≤ t) (hτ : 0 ≤ τ) (hσ : 0 ≤ σ) {v : ℕ → ℝ}
    (hv : ∀ k, 0 ≤ v k) (ℓ n : ℕ) : 0 ≤ PhiC r t τ σ ℓ n v := by
  unfold PhiC rhoC drhoC d2rhoC
  have h0 := hv n; have h1 := hv (n - 1); have h2 := hv (n - 2); have h3 := hv (n - 3)
  positivity

theorem PhiC_add3 (r t τ σ : ℝ) (ℓ k : ℕ) (v : ℕ → ℝ) :
    PhiC r t τ σ ℓ (k + 3) v = rhoC r t τ σ (ℓ + (k + 3)) * v (k + 3) +
      ((k : ℝ) + 3) * drhoC t τ σ (ℓ + (k + 2)) * v (k + 2) +
      ((k + 3).choose 2 : ℝ) * d2rhoC τ σ (ℓ + (k + 1)) * v (k + 1) + ((k + 3).choose 3 : ℝ) * σ * v k := by
  unfold PhiC
  rw [show k + 3 - 1 = k + 2 by omega, show k + 3 - 2 = k + 1 by omega, show k + 3 - 3 = k by omega]
  push_cast; ring

